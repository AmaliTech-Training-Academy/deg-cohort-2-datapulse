# ─────────────────────────────────────────────────────────────────────────────
#  DataPulse — Environment Variable Template
#  1. Copy this file:  cp .env.example .env
#  2. Fill in values below
#  3. NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-this-before-running
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# Inside Docker Compose, DB_HOST must be the service name: "db"
# Running locally without Docker, set DB_HOST=localhost and DB_PORT=5432
DB_NAME=datapulse
DB_USER=datapulse_user
DB_PASSWORD=datapulse_pass
DB_HOST=db
DB_PORT=5432

# ── Analytics Database ────────────────────────────────────────────────────────
ANALYTICS_DB_NAME=datapulse_analytics
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=analytics_pass

# ── Pipeline (ETL) ────────────────────────────────────────────────────────────
# SOURCE_DB_URL and TARGET_DB_URL are auto-constructed from the vars above.
# Override them here only if you need to point the pipeline at a different host.
#SOURCE_DB_URL=postgresql://datapulse_user:datapulse_pass@db:5432/datapulse
#TARGET_DB_URL=postgresql://analytics_user:analytics_pass@analytics_db:5432/datapulse_analytics

# ── Docker port mappings ──────────────────────────────────────────────────────
# Host-side ports exposed by Docker Compose.
# Change these if the defaults conflict with other services on your machine.
DB_EXTERNAL_PORT=5433
ANALYTICS_DB_EXTERNAL_PORT=5437
WEB_PORT=8000

# ── File storage ──────────────────────────────────────────────────────────────
MEDIA_ROOT=media
MEDIA_URL=/media/

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://127.0.0.1:3000

# ── JWT token lifetime ────────────────────────────────────────────────────────
# Set high for demo convenience. Lower in production.
JWT_ACCESS_TOKEN_HOURS=24
JWT_REFRESH_TOKEN_DAYS=7

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Email ─────────────────────────────────────────────────────────────────────
# Development default: prints emails to the console (no SMTP needed).
# For production, switch to the SMTP backend and fill in the SMTP vars below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=DataPulse <noreply@datapulse.io>

# ── Frontend URL (used in email links) ────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
