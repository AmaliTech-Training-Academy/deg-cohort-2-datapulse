# ─────────────────────────────────────────────────────────────────────────────
#  DataPulse — Environment Variable Template
#  1. Copy this file:  cp .env.example .env
#  2. Fill in values below
#  3. NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-this-before-running
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# Inside Docker Compose, DB_HOST must be the service name: "db"
# Running locally without Docker, set DB_HOST=localhost and DB_PORT=5432
DB_NAME=datapulse
DB_USER=datapulse_user
DB_PASSWORD=datapulse_pass
DB_HOST=db
DB_PORT=5432

# ── Docker port mappings ──────────────────────────────────────────────────────
DB_EXTERNAL_PORT=5433
WEB_PORT=8000

# ── File storage ──────────────────────────────────────────────────────────────
MEDIA_ROOT=media
MEDIA_URL=/media/

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://127.0.0.1:3000

# ── JWT token lifetime ────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_HOURS=24
JWT_REFRESH_TOKEN_DAYS=7

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
