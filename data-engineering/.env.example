# Source — backend DB (exposed on host port 5433 by backend compose)
# SOURCE_DB_URL=postgresql://datapulse_user:datapulse_pass@host.docker.internal:5433/datapulse

# # Target — analytics DB defined above
# TARGET_DB_URL=postgresql://analytics_user:analytics_pass@analytics_db:5432/datapulse_analytics

# # Analytics DB credentials
# ANALYTICS_DB_NAME=datapulse_analytics
# ANALYTICS_DB_USER=analytics_user
# ANALYTICS_DB_PASSWORD=analytics_pass
# ANALYTICS_DB_EXTERNAL_PORT=5434


# ─────────────────────────────────────────────
# SOURCE DB (Django / origin database)
# ─────────────────────────────────────────────
SOURCE_DB_URL=postgresql://datapulse_user:datapulse_pass@deg-cohort-2-datapulse-db-1:5432/datapulse


# ─────────────────────────────────────────────
# TARGET DB (Analytics warehouse)
# ─────────────────────────────────────────────
TARGET_DB_URL=postgresql://analytics_user:analytics_pass@analytics_db:5432/datapulse_analytics


# ─────────────────────────────────────────────
# Analytics DB credentials (used by docker / services)
# ─────────────────────────────────────────────
ANALYTICS_DB_NAME=datapulse_analytics
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=analytics_pass
ANALYTICS_DB_EXTERNAL_PORT=5436